# Competitor Watch — every environment variable the project reads.
#
# Copy to .env for local development; .env is gitignored, this file is not.
# In the cluster the same shape generates the k8s objects:
#
#   kubectl create secret generic cw-secrets --from-env-file=.env
#   kubectl create configmap  cw-config     --from-env-file=.env
#
# Two rules this file follows, both to keep one file meaning one thing
# everywhere:
#
#   1. No ${VAR} references. python-dotenv would expand them, but
#      `kubectl --from-env-file` and `docker compose env_file:` copy values
#      literally, so a composed value would reach the app as the characters
#      "${POSTGRES_USER}". DATABASE_URL is assembled in backend/config.py.
#
#   2. No comments on the same line as a variable. python-dotenv strips a
#      trailing comment only when a value precedes it: `KEY=   # hint` parses
#      as the value "# hint", not as empty. An empty secret with a hint beside
#      it would therefore start the app with the hint as its password.
#
# Values shown are the defaults the code already applies — leaving one unset and
# setting it to the value here mean the same thing. Only the secrets are
# required.

# --- secrets (required) ---------------------------------------------------

# openssl rand -hex 16
POSTGRES_PASSWORD=

# openssl rand -hex 32 — must be identical for the backend and the crawler,
# or every delivery is a 401.
WEBHOOK_SECRET=

# Read by the Gemini SDK directly, not through our config.
GEMINI_API_KEY=

# --- database -------------------------------------------------------------

# Set this to use a connection string verbatim — a managed database, or one
# needing options the parts below don't cover. Leave it empty and the URL is
# built from POSTGRES_* instead.
DATABASE_URL=

POSTGRES_USER=cw
POSTGRES_DB=competitor_watch
POSTGRES_HOST=postgres.cw-dev.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# --- endpoints ------------------------------------------------------------

# Cluster-internal DNS: /ingest is not exposed through the Ingress, so the
# crawler reaches the backend directly.
BACKEND_INGEST_URL=http://competitor-watch-backend.cw-dev.svc.cluster.local:8080/ingest

# The dashboard's API base. A path, not a domain — the dashboard and the API
# share one origin behind the Ingress, so one frontend image serves every
# environment.
#
# NOTE: Next.js inlines this at BUILD time. Setting it in the pod environment
# has no effect at all; pass it to the image build.
NEXT_PUBLIC_API_BASE_URL=/api

# --- backend --------------------------------------------------------------

PORT=8080

# Case-insensitive: debug and DEBUG both work.
LOG_LEVEL=INFO

# Archived page HTML is cleared past this age by scripts/prune_snapshots.py.
# The finding and its audit chain are kept; only re-rendering the page is lost.
SNAPSHOT_RETENTION_DAYS=90

# --- crawler --------------------------------------------------------------

# false stops the crawl before any paid call is made.
CRAWL_ENABLED=true

# 30 for the monthly backfill, 365 for a first-time run.
SEARCH_WINDOW_DAYS=3

# How long the crawler waits on /ingest. Must exceed CLASSIFY_TIMEOUT_MS below,
# or the client gives up while the backend is still working correctly.
BACKEND_TIMEOUT_SECONDS=90

# Delivery retries, on timeouts and 5xx only. Free in model tokens: /ingest is
# idempotent on routine_run_id and commits that row before classifying, so a
# repeat never reaches the model. Running out of attempts is not data loss —
# the next daily crawl re-reports the finding.
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BACKOFF_SECONDS=2

# --- model ----------------------------------------------------------------

GEMINI_MODEL=gemini-3.6-flash

# Retries only 429/500/502/503/504; backoff is linear (2s, 4s, ...).
GEMINI_MAX_ATTEMPTS=3
GEMINI_BACKOFF_SECONDS=2

# Three call sites, tuned separately because they do different work.
#
#   discover  — grounded web search. Needs a reasoning budget and the longest
#               timeout; the only call that reaches out to the web.
#   structure — shapes found material into a fixed schema. No reasoning needed,
#               but the output is a list, so it needs the most output tokens.
#   classify  — one short verdict over an excerpt already in the prompt. Needs
#               neither, and must be the strictest timeout of the three: it runs
#               inside a request the crawler is waiting on.
#
# A thinking budget of 0 disables extended thinking.

DISCOVER_TIMEOUT_MS=120000
DISCOVER_MAX_OUTPUT_TOKENS=4096
DISCOVER_THINKING_BUDGET=2048

STRUCTURE_TIMEOUT_MS=90000
STRUCTURE_MAX_OUTPUT_TOKENS=8192
STRUCTURE_THINKING_BUDGET=0

CLASSIFY_TIMEOUT_MS=45000
CLASSIFY_MAX_OUTPUT_TOKENS=1024
CLASSIFY_THINKING_BUDGET=0

# --- crawl limits ---------------------------------------------------------
# Ceilings, not targets. Each turns a runaway run into a logged, bounded event;
# whatever gets dropped is always logged.

# Capped before fetching — every extra source costs a page fetch and roughly
# 750 prompt tokens downstream.
MAX_SOURCES_PER_KEYWORD=15

# The research summary fed to the structuring call.
MAX_SUMMARY_CHARS=12000

MAX_FINDINGS_PER_KEYWORD=20

# Whole run. Hitting it abandons the remaining keywords.
MAX_FINDINGS_PER_CRAWL=200

# Parallel page fetches.
FETCH_CONCURRENCY=6
